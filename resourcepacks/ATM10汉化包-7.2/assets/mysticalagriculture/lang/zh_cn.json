 "crop.mysticalagriculture.end_steel": "末地钢",
 "augment.mysticalagriculture.absorption_i.description": "每8分钟获得2颗心的伤害吸收值。",
 "augment.mysticalagriculture.luck_i": "幸运 I",
 "augment.mysticalagriculture.luck_i.description": "获得幸运 I效果。",
 "augment.mysticalagriculture.health_boost_i.description": "增加2颗心的最大生命值。",
 "augment.mysticalagriculture.pathing_aoe_i.description": "潜行时制造土径范围提升至3x3。",
 "augment.mysticalagriculture.nausea_resistance": "反胃抗性",
 "augment.mysticalagriculture.nausea_resistance.description": "免疫反胃效果。",
 "augment.mysticalagriculture.night_vision.description": "获得夜视效果。",
 "augment.mysticalagriculture.water_breathing.description": "获得水下呼吸效果。",
 "augment.mysticalagriculture.absorption_ii.description": "每8分钟获得4颗心的伤害吸收值。",
