{
	quest.2F5263A4166BFCD6.quest_desc: [
		"这座水晶塔能防止你在选定的区块范围内误破坏特定方块/误杀特定生物。\\n\\n用生物过滤器防止水晶塔范围内误杀某种生物，用方块过滤器防止误拆某种方块。\\n\\n可以叠放多个生物和方块过滤器来同时保护多种生物/方块。"
	]
	quest.2F5263A4166BFCD6.quest_subtitle: "告别手滑！"
	quest.77B185799366ACD2.quest_desc: [
		"设置方块过滤器很简单：拿着它点击你想防止误拆的方块即可。\\n\\n每个过滤器只能记录 1 种方块，所以如果想让蜂箱、线缆、箱子、熔炉和酿造台都不被误拆，你需要 5 个方块过滤器。\\n\\n想换绑定方块，拿着它点击别的方块就行。"
	]
}
